# Remnawave API. If the limiter shares remnawave-network with the panel,
# use the internal Docker address.
REMNAWAVE_API_URL=http://remnawave:3000
REMNAWAVE_API_TOKEN=CHANGE_ME

# Optional additional auth for a panel behind WAF/Caddy. Usually empty when
# REMNAWAVE_API_URL points directly to http://remnawave:3000.
REMNAWAVE_COOKIES=
REMNAWAVE_HEADERS=

# Dedicated Valkey/Redis used by this limiter.
REDIS_URL=redis://redis:6379

# Internal Squad UUIDs.
TRAFFIC_LIMITED_SQUAD_UUID=CHANGE_ME
TRAFFIC_UNLIMITED_SQUAD_UUID=CHANGE_ME

# Incoming Remnawave webhook.
TRAFFIC_WEBHOOK_ADDR=:8081
REMNAWAVE_WEBHOOK_SECRET=CHANGE_ME_SAME_VALUE_AS_WEBHOOK_SECRET_HEADER

# Seconds. Also repairs a missed user.limited webhook by scanning users with
# status LIMITED and retries incomplete state transitions.
TRAFFIC_RECONCILE_INTERVAL=60

LOG_LEVEL=info
LOG_FORMAT=text
